# =====================================================================
# .env.example - modelo das variáveis de ambiente do laboratório
#
# O docker-compose.yml JÁ possui valores padrão, então "docker compose up -d"
# funciona sem este arquivo. Para personalizar as senhas:
#     cp .env.example .env
# O arquivo ".env" está no .gitignore e nunca deve ser enviado ao GitHub.
#
# ATENÇÃO: estas são senhas de LABORATÓRIO. Em produção, use senhas fortes
# e um gerenciador de segredos (Docker secrets, Vault etc.).
# =====================================================================

# Banco de dados
POSTGRES_DB=lojadb
# Administrador do banco: só acessa pelo socket local do container.
POSTGRES_USER=dbadmin
POSTGRES_PASSWORD=Adm1n-Lab-2026

# Usuário da aplicação (servidor web): privilégio mínimo.
APP_DB_PASSWORD=App-Lab-2026
